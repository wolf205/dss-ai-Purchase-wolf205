generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id           BigInt   @id @default(autoincrement())
  categoryCode String   @unique @map("category_code") @db.VarChar(50)
  categoryName String   @map("category_name") @db.VarChar(100)
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  products               Product[]
  recommendationSessions RecommendationSession[]

  @@map("categories")
}

model Product {
  id               BigInt   @id @default(autoincrement())
  skuCode          String   @unique @map("sku_code") @db.VarChar(50)
  productName      String   @map("product_name") @db.VarChar(255)
  barcode          String?  @unique @db.VarChar(50)
  unit             String   @db.VarChar(30)
  status           String   @default("Active") @db.VarChar(20)
  currentInventory Int      @default(0) @map("current_inventory")
  onOrderQuantity  Int      @default(0) @map("on_order_quantity")
  categoryId       BigInt   @map("category_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplyConditions    SupplyCondition[]
  salesRecords        SalesRecord[]
  inventorySnapshots  InventorySnapshot[]
  recommendationItems RecommendationItem[]
  poLineItems         POLineItem[]
  receiptLineItems    ReceiptLineItem[]

  @@map("products")
}

model Supplier {
  id                      BigInt   @id @default(autoincrement())
  supplierCode            String   @unique @map("supplier_code") @db.VarChar(50)
  supplierName            String   @map("supplier_name") @db.VarChar(255)
  contactPerson           String?  @map("contact_person") @db.VarChar(100)
  phoneNumber             String?  @map("phone_number") @db.VarChar(50)
  email                   String?  @db.VarChar(100)
  address                 String?  @db.Text
  committedLeadTimeDays   Int      @map("committed_lead_time_days")
  status                  String   @default("Active") @db.VarChar(20)
  performanceScore        Decimal  @default(0.8000) @map("performance_score") @db.Decimal(5, 4)
  allTimePerformanceScore Decimal  @default(0.8000) @map("all_time_performance_score") @db.Decimal(5, 4)
  completedOrderCount     Int      @default(0) @map("completed_order_count")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  supplyConditions SupplyCondition[]
  purchaseOrders   PurchaseOrder[]
  suggestedItems   RecommendationItem[] @relation("SuggestedSupplier")
  approvedItems    RecommendationItem[] @relation("ApprovedSupplier")

  @@map("suppliers")
}

model SupplyCondition {
  id            BigInt   @id @default(autoincrement())
  productId     BigInt   @map("product_id")
  supplierId    BigInt   @map("supplier_id")
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(15, 2)
  moq           Int      @default(1)
  status        String   @default("Active") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@unique([productId, supplierId])
  @@map("supply_conditions")
}

model SalesRecord {
  id           BigInt   @id @default(autoincrement())
  productId    BigInt   @map("product_id")
  saleDate     DateTime @map("sale_date") @db.Date
  quantitySold Int      @map("quantity_sold")
  revenue      Decimal  @default(0.00) @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, saleDate])
  @@map("sales_records")
}

model InventorySnapshot {
  id              BigInt   @id @default(autoincrement())
  productId       BigInt   @map("product_id")
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  countedQuantity Int      @map("counted_quantity")
  countedBy       String?  @map("counted_by") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, snapshotDate])
  @@map("inventory_snapshots")
}

model DSSConfiguration {
  id                 Int      @id @default(1)
  priceWeight        Decimal  @default(0.4000) @map("price_weight") @db.Decimal(5, 4)
  leadTimeWeight     Decimal  @default(0.2000) @map("lead_time_weight") @db.Decimal(5, 4)
  moqWeight          Decimal  @default(0.1500) @map("moq_weight") @db.Decimal(5, 4)
  historyWeight      Decimal  @default(0.2500) @map("history_weight") @db.Decimal(5, 4)
  targetServiceLevel Decimal  @default(0.9500) @map("target_service_level") @db.Decimal(5, 4)
  zFactor            Decimal  @default(1.65) @map("z_factor") @db.Decimal(4, 2)
  reviewPeriodDays   Int      @default(7) @map("review_period_days")
  updatedBy          String   @default("Store Manager") @map("updated_by") @db.VarChar(100)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("dss_configurations")
}

model RecommendationSession {
  id                   BigInt    @id @default(autoincrement())
  sessionCode          String    @unique @map("session_code") @db.VarChar(50)
  categoryId           BigInt?   @map("category_id")
  scope                String    @default("All Categories") @db.VarChar(100)
  status               String    @default("Draft") @db.VarChar(20)
  totalSuggestedAmount Decimal   @default(0.00) @map("total_suggested_amount") @db.Decimal(15, 2)
  totalApprovedAmount  Decimal   @default(0.00) @map("total_approved_amount") @db.Decimal(15, 2)
  createdBy            String    @map("created_by") @db.VarChar(100)
  approvedAt           DateTime? @map("approved_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category       Category?            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items          RecommendationItem[]
  purchaseOrders PurchaseOrder[]

  @@map("recommendation_sessions")
}

model RecommendationItem {
  id                        BigInt   @id @default(autoincrement())
  sessionId                 BigInt   @map("session_id")
  productId                 BigInt   @map("product_id")
  forecastedDemand          Decimal  @default(0.00) @map("forecasted_demand") @db.Decimal(10, 2)
  dailyForecasts            Json?    @map("daily_forecasts")
  snapshotCurrentInventory  Int      @default(0) @map("snapshot_current_inventory")
  snapshotOnOrderQuantity   Int      @default(0) @map("snapshot_on_order_quantity")
  safetyStock               Int      @default(0) @map("safety_stock")
  reorderPoint              Int      @default(0) @map("reorder_point")
  abcXyzGroup               String   @map("abc_xyz_group") @db.VarChar(2)
  stockRiskStatus           String   @map("stock_risk_status") @db.VarChar(30)
  suggestedQuantity         Int      @default(0) @map("suggested_quantity")
  suggestedSupplierWsmScore Decimal? @map("suggested_supplier_wsm_score") @db.Decimal(5, 4)
  suggestedSupplierId       BigInt?  @map("suggested_supplier_id")
  supplierRankings          Json?    @map("supplier_rankings")
  approvedQuantity          Int      @default(0) @map("approved_quantity")
  approvedSupplierId        BigInt?  @map("approved_supplier_id")
  isOverridden              Boolean  @default(false) @map("is_overridden")
  whyBuyExplanation         String?  @map("why_buy_explanation") @db.Text
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  session           RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  suggestedSupplier Supplier?             @relation("SuggestedSupplier", fields: [suggestedSupplierId], references: [id], onDelete: Restrict)
  approvedSupplier  Supplier?             @relation("ApprovedSupplier", fields: [approvedSupplierId], references: [id], onDelete: Restrict)

  @@unique([sessionId, productId])
  @@map("recommendation_items")
}

model PurchaseOrder {
  id                     BigInt    @id @default(autoincrement())
  poNumber               String    @unique @map("po_number") @db.VarChar(50)
  supplierId             BigInt    @map("supplier_id")
  sessionId              BigInt    @map("session_id")
  status                 String    @default("Approved") @db.VarChar(20)
  approvalDate           DateTime  @default(dbgenerated("CURRENT_DATE")) @map("approval_date") @db.Date
  historicalLeadTimeDays Int       @map("historical_lead_time_days")
  expectedDeliveryDate   DateTime  @map("expected_delivery_date") @db.Date
  totalAmount            Decimal   @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  cancellationReason     String?   @map("cancellation_reason") @db.VarChar(255)
  cancelledAt            DateTime? @map("cancelled_at") @db.Timestamptz
  lastExportedAt         DateTime? @map("last_exported_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  session      RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  lineItems    POLineItem[]
  goodsReceipt GoodsReceipt?

  @@map("purchase_orders")
}

model POLineItem {
  id                  BigInt   @id @default(autoincrement())
  poId                BigInt   @map("po_id")
  productId           BigInt   @map("product_id")
  quantity            Int
  historicalUnitPrice Decimal  @map("historical_unit_price") @db.Decimal(15, 2)
  historicalMoq       Int      @default(1) @map("historical_moq")
  lineTotal           Decimal? @map("line_total") @db.Decimal(15, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  po              PurchaseOrder    @relation(fields: [poId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLineItem ReceiptLineItem?

  @@unique([poId, productId])
  @@map("po_line_items")
}

model GoodsReceipt {
  id                     BigInt   @id @default(autoincrement())
  receiptNumber          String   @unique @map("receipt_number") @db.VarChar(50)
  poId                   BigInt   @unique @map("po_id")
  actualDeliveryDate     DateTime @map("actual_delivery_date") @db.Date
  daysLate               Int      @map("days_late")
  onTimeFactor           Decimal  @map("on_time_factor") @db.Decimal(5, 4)
  overallFulfillmentRate Decimal  @map("overall_fulfillment_rate") @db.Decimal(5, 4)
  orderPerformanceScore  Decimal  @map("order_performance_score") @db.Decimal(5, 4)
  notes                  String?  @db.Text
  receivedBy             String   @map("received_by") @db.VarChar(100)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  po        PurchaseOrder     @relation(fields: [poId], references: [id], onDelete: Restrict)
  lineItems ReceiptLineItem[]

  @@map("goods_receipts")
}

model ReceiptLineItem {
  id                  BigInt   @id @default(autoincrement())
  receiptId           BigInt   @map("receipt_id")
  poLineItemId        BigInt   @unique @map("po_line_item_id")
  productId           BigInt   @map("product_id")
  orderedQuantity     Int      @map("ordered_quantity")
  receivedQuantity    Int      @map("received_quantity")
  historicalUnitPrice Decimal  @map("historical_unit_price") @db.Decimal(15, 2)
  lineReceivedTotal   Decimal? @map("line_received_total") @db.Decimal(15, 2)
  itemFulfillmentRate Decimal? @map("item_fulfillment_rate") @db.Decimal(5, 4)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  receipt    GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLineItem POLineItem   @relation(fields: [poLineItemId], references: [id], onDelete: Restrict)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("receipt_line_items")
}

model User {
  id           BigInt    @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(100)
  role         String    @db.VarChar(20)
  status       String    @default("Active") @db.VarChar(20)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  clientIp  String?   @map("client_ip") @db.VarChar(50)
  userAgent String?   @map("user_agent") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ActivityLog {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt?  @map("user_id")
  username    String   @db.VarChar(50)
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.VarChar(50)
  description String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

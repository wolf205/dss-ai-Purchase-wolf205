# Backend NestJS Environment Variables
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://dss_admin:dss_secret_pass@localhost:5432/dss_retail_db?schema=public

# AI Forecasting Service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_for_dss_purchase_system
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173,http://localhost:80

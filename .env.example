# ==============================================================================
# DSS AI-PURCHASE SYSTEM - ROOT ENVIRONMENT CONFIGURATION
# Project: AI-Powered Purchase Decision Support System for a Single Retail Store
# ==============================================================================

# Database Configuration (PostgreSQL 16+)
POSTGRES_USER=dss_admin
POSTGRES_PASSWORD=dss_secret_pass
POSTGRES_DB=dss_retail_db
POSTGRES_PORT=5432

# Connection string for Backend NestJS / Prisma ORM
DATABASE_URL=postgresql://dss_admin:dss_secret_pass@localhost:5432/dss_retail_db?schema=public

# Backend Web API Configuration
PORT=3000
NODE_ENV=development

# AI Forecasting Service (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# Google Gemini API Key (For On-Demand LLM Explanation in UC-01)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication & IAM Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_for_dss_purchase_system
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
